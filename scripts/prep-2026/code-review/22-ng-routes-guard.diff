+import { Component, inject } from '@angular/core'
+import { FormBuilder, ReactiveFormsModule } from '@angular/forms'
+import { ActivatedRoute, Router } from '@angular/router'
+import { InvoicesService, type Invoice } from './invoices.service'
+
+@Component({
+  selector: 'app-invoice-edit',
+  standalone: true,
+  imports: [ReactiveFormsModule],
+  templateUrl: './invoice-edit.component.html',
+})
+export class InvoiceEditComponent {
+  invoice = inject(ActivatedRoute).snapshot.data['invoice'] as Invoice
+  form = inject(FormBuilder).group({ amount: [this.invoice.amount], note: [this.invoice.note] })
+
+  save() {
+    inject(InvoicesService).update(this.invoice.id, this.form.value)
+      .subscribe(() => inject(Router).navigate(['/invoices']))
+  }
+}
