+import { Router } from 'express'
+import { db } from '../db'
+import { requireUser } from '../auth'
+
+export const exportRoute = Router()
+
+// GET /api/export?accountId=...&name=march
+exportRoute.get('/api/export', requireUser, (req, res) => {
+  res.setHeader('Content-Type', 'text/csv')
+  res.setHeader('Content-Disposition', `attachment; filename=${req.query.name}.csv`)
+  res.write('date,description,amount\n')
+
+  const cursor = db.collection('transactions').find({ accountId: req.query.accountId }).stream()
+
+  cursor.on('data', doc => {
+    res.write(`${doc.date},${doc.description},${doc.amount}\n`)
+  })
+  cursor.on('end', () => res.end())
+  cursor.on('error', err => {
+    res.status(500).json({ error: err.message, stack: err.stack, config: db.options })
+  })
+})
