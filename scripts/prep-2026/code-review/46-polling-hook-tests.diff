+import { renderHook, waitFor } from '@testing-library/react'
+import { useBuildStatus } from './usePolling'
+
+test('updates the status', async () => {
+  global.fetch = jest.fn().mockResolvedValue({ json: () => Promise.resolve({ status: 'done' }) })
+  const { result } = renderHook(() => useBuildStatus('42'))
+  await waitFor(() => expect(result.current).toBe('done'), { timeout: 6000 })
+})
