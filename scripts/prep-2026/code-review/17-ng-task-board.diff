+import { ChangeDetectionStrategy, Component, EventEmitter, Input, Output } from '@angular/core'
+import { TaskCardComponent } from './task-card.component'
+import type { Task } from './task'
+
+@Component({
+  selector: 'app-task-board',
+  standalone: true,
+  imports: [TaskCardComponent],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  template: `
+    <button (click)="addTask()">Add task</button>
+    @for (task of tasks; track $index) {
+      <app-task-card [task]="task" [label]="formatLabel(task)" (toggle)="toggle(task)" />
+    }
+    <p>{{ completedCount() }} of {{ tasks.length }} done</p>
+  `,
+})
+export class TaskBoardComponent {
+  @Input() tasks: Task[] = []
+  @Output() tasksChange = new EventEmitter<Task[]>()
+
+  addTask() {
+    this.tasks.push({ id: crypto.randomUUID(), title: 'New task', done: false, tags: [] })
+    this.tasksChange.emit(this.tasks)
+  }
+
+  toggle(task: Task) {
+    task.done = !task.done
+  }
+
+  formatLabel(task: Task) {
+    return `${task.title} · ${task.tags.map(t => t.toUpperCase()).join(', ')}`
+  }
+
+  completedCount() {
+    return this.tasks.filter(t => t.done).length
+  }
+}

