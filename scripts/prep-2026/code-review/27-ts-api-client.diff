+const BASE_URL = process.env.NEXT_PUBLIC_API_URL
+
+export async function api(path: string, options: any = {}): Promise<any> {
+  const res = await fetch(BASE_URL + path, { ...options, headers: { 'Content-Type': 'application/json' } })
+  return res.json()
+}
+
+export interface User {
+  id: string
+  name: string
+  email: string
+  role: 'admin' | 'member'
+  createdAt: string
+}
+
+export async function getUser(id: string) {
+  const data = await api(`/users/${id}`)
+  return data as User
+}
+
+export async function updateUser(id: string, patch: any) {
+  return api(`/users/${id}`, { method: 'PUT', body: patch }) as Promise<User>
+}
+
+export function isAdmin(user: User | undefined) {
+  return user!.role == 'admin'
+}
+
+export async function listUsers(page?: number) {
+  const data = await api(`/users?page=${page}`)
+  return (data.items as User[]).map(u => ({ ...u, createdAt: new Date(u.createdAt) }))
+}

