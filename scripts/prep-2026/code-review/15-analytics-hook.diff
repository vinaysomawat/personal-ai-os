@@ -0,0 +1,40 @@
+import { useEffect } from 'react'
+import { useUser } from './useUser'
+
+function send(event: string, props: Record<string, unknown>) {
+  fetch('https://collect.example-analytics.io/v1/events', {
+    method: 'POST',
+    body: JSON.stringify({ event, props, ts: Date.now() }),
+  })
+}
+
+export function useAnalytics(page: string) {
+  const user = useUser()
+
+  useEffect(() => {
+    send('Page View', { page, email: user?.email, name: user?.name })
+  })
+
+  return {
+    track: (event: string, props: Record<string, unknown> = {}) => send(event, { ...props, email: user?.email }),
+  }
+}
