+export type Product = { id: string; name: string; price: number }
+
+// min and max come straight from the two text inputs.
+export function filterByPrice(products: Product[], min: string, max: string) {
+  return products.filter(p => {
+    if (min && String(p.price) < min) return false
+    if (max && p.price >= Number(max)) return false
+    return true
+  })
+}
+
