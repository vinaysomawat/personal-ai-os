+import { filterByPrice } from './filterByPrice'
+
+const products = [
+  { id: '1', name: 'Mug', price: 8 },
+  { id: '2', name: 'Lamp', price: 40 },
+  { id: '3', name: 'Chair', price: 120 },
+]
+
+describe('filterByPrice', () => {
+  it('returns everything with no limits', () => {
+    expect(filterByPrice(products, '', '')).toHaveLength(3)
+  })
+
+  it('filters by range', () => {
+    const result = filterByPrice(products, '5', '50')
+    expect(result.length).toBeGreaterThan(0)
+  })
+})
