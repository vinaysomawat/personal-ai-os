+import { Component, OnInit } from '@angular/core'
+import { AbstractControl, FormControl, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms'
+import { SignupService } from './signup.service'
+
+@Component({
+  selector: 'app-signup',
+  standalone: true,
+  imports: [ReactiveFormsModule],
+  templateUrl: './signup.component.html',
+})
+export class SignupComponent implements OnInit {
+  form = new FormGroup({
+    email: new FormControl(''),
+    password: new FormControl('', [Validators.required, Validators.minLength(8)]),
+    confirm: new FormControl('', [this.matchPassword]),
+    plan: new FormControl('free'),
+    company: new FormControl(''),
+  })
+
+  constructor(private api: SignupService) {}
+
+  matchPassword(control: AbstractControl) {
+    return control.value === this.form?.get('password')?.value ? null : { mismatch: true }
+  }
+
+  ngOnInit() {
+    this.form.get('plan')!.valueChanges.subscribe(plan => {
+      if (plan === 'team') this.form.get('company')!.setValidators(Validators.required)
+    })
+  }
+
+  submit() {
+    this.api.create(this.form.value).subscribe()
+  }
+}

