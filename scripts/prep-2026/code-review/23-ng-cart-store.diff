+import { HttpClient } from '@angular/common/http'
+import { Injectable, NgZone } from '@angular/core'
+import { BehaviorSubject } from 'rxjs'
+
+export interface CartItem { id: string; name: string; price: number; qty: number }
+
+@Injectable({ providedIn: 'root' })
+export class CartStore {
+  readonly items$ = new BehaviorSubject<CartItem[]>([])
+  private ticker: any
+
+  constructor(private http: HttpClient, private zone: NgZone) {
+    // Outside the zone so the timer doesn't trigger change detection.
+    this.zone.runOutsideAngular(() => {
+      this.ticker = setInterval(() => this.refreshPrices(), 60000)
+    })
+  }
+
+  add(item: CartItem) {
+    this.items$.value.push(item)
+  }
+
+  remove(id: string) {
+    const items = this.items$.value
+    items.splice(items.findIndex(i => i.id === id), 1)
+    this.items$.next(items)
+  }
+
+  refreshPrices() {
+    this.http.get<Record<string, number>>('/api/prices').subscribe(prices => {
+      this.items$.value.forEach(i => (i.price = prices[i.id]))
+    })
+  }
+
+  get total() {
+    return this.items$.value.reduce((sum, i) => sum + i.price * i.qty, 0)
+  }
+}

