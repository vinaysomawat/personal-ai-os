+import { useEffect } from 'react'
+import { useDispatch, useSelector } from 'react-redux'
+import { appSlice, loadEverything } from '@/store/appSlice'
+
+export function TaskPage() {
+  const state = useSelector((s: RootState) => s.app)
+  const dispatch = useDispatch<AppDispatch>()
+
+  useEffect(() => {
+    dispatch(loadEverything())
+  }, [])
+
+  if (state.loading) return <Spinner />
+  return (
+    <TaskTable
+      tasks={state.tasks}
+      search={state.searchText}
+      onSearch={(text: string) => dispatch(appSlice.actions.set({ searchText: text }))}
+      onHover={(id: string) => dispatch(appSlice.actions.set({ hoveredRow: id }))}
+    />
+  )
+}
