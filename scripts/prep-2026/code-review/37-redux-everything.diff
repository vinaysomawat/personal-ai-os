+import { createSlice } from '@reduxjs/toolkit'
+import { api } from '@/lib/api'
+
+// One place for everything, so every page shares the same data.
+export const appSlice = createSlice({
+  name: 'app',
+  initialState: {
+    user: null, projects: [], tasks: [], comments: [],
+    loading: false, error: null,
+    modalOpen: false, searchText: '', hoveredRow: null,
+  } as any,
+  reducers: {
+    set: (state, action) => ({ ...state, ...action.payload }),
+  },
+})
+
+export const loadEverything = () => async (dispatch: AppDispatch) => {
+  dispatch(appSlice.actions.set({ loading: true }))
+  const [user, projects, tasks, comments] = await Promise.all([api.me(), api.projects(), api.tasks(), api.comments()])
+  dispatch(appSlice.actions.set({ user, projects, tasks, comments, loading: false }))
+}

