@@ -0,0 +1,24 @@
+import { cookies } from 'next/headers'
+import { Dashboard } from './Dashboard'
+import { getInvoices, getUsage } from '@/lib/billing'
+
+// Account rarely changes, keep it in memory for a minute.
+let accountCache: { data: Account; at: number } | null = null
+
+async function getAccount(): Promise<Account> {
+  if (accountCache && Date.now() - accountCache.at < 60_000) return accountCache.data
+  const token = (await cookies()).get('session')?.value
+  const res = await fetch(`${process.env.API_URL}/me`, {
+    headers: { Authorization: `Bearer ${token}` },
+    cache: 'force-cache',
+  })
+  accountCache = { data: await res.json(), at: Date.now() }
+  return accountCache.data
+}
+
+export default async function DashboardPage() {
+  const account = await getAccount()
+  const invoices = await getInvoices(account.id)
+  const usage = await getUsage(account.id)
+  return <Dashboard account={account} invoices={invoices} usage={usage} />
+}

